# ============================================================
# AI-3D-Hub API Importer – Konfiguration
# Diese Datei nach ".env" kopieren und anpassen.
# ============================================================

# Adresse deines AI-3D-Hub inkl. Protokoll und Port (ohne / am Ende)
AI3DHUB_URL=http://192.168.1.10:8787

# API-Key aus der WebUI (Schlüssel-Symbol oben rechts -> "API-Zugang")
AI3DHUB_API_KEY=

# Ordner, dessen Unterordner jeweils als eigenes Projekt hochgeladen werden
# Windows-Beispiel: C:\Users\Name\Documents\3D Modelle
IMPORT_DIR=

# Metadaten für die neuen Projekte (leer lassen = nicht setzen)
STATUS=AutoUpload
TAGS=
CATEGORY=

# Was tun, wenn es das Projekt im Hub schon gibt?
#   skip   = überspringen, lokaler Ordner bleibt unverändert liegen
#   suffix = trotzdem anlegen als "Projekt 1 (2)"
ON_CONFLICT=skip

# Was passiert nach erfolgreichem Upload mit dem lokalen Ordner?
#   rename = DONE_PREFIX voranstellen (z.B. "Uploaded_Projekt 1"); diese Ordner werden künftig ignoriert
#   delete = Ordner endgültig löschen (nicht über den Papierkorb!)
#   keep   = nichts tun
AFTER_UPLOAD=rename
DONE_PREFIX=Uploaded_

# Nur für https mit selbstsigniertem Zertifikat auf false setzen
VERIFY_SSL=true
